generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  user
  premium
  mod
  admin
}

// Un solo lugar de verdad para qué puede elegir cada rol al crear un
// anuncio o al configurar su radio de escucha. Antes esto eran listas
// fijas en el código (ALLOWED_RADIUS_METERS, etc.) — ahora vive acá, y el
// panel de admin las edita. Si no existe fila para un rol, el backend usa
// valores por defecto (ver role-limits.defaults.ts) para no romperse.
model RoleLimits {
  role                  UserRole @id
  allowedPingRadii      Int[] // metros, ej. [50,100,200,300,400,500]
  allowedListeningRadii Int[] // metros
  allowedDurations      Int[] // minutos
  // Placeholder — hoy no limita nada de verdad, solo se muestra
  // deshabilitado en el formulario de crear anuncio.
  maxListenersPerPing   Int      @default(50)
  updatedAt             DateTime @updatedAt
}

// Configuración global (no depende del rol) — hoy solo el largo del
// mensaje. Fila única, id fijo "default".
model PlatformSettings {
  id               String   @id @default("default")
  minMessageLength Int      @default(5)
  maxMessageLength Int      @default(280)
  updatedAt        DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  displayName  String
  role         UserRole @default(user)
  isDisabled   Boolean  @default(false)
  // Categorías de anuncio que quiere ver ("venta", "ayuda", etc.) — un
  // array vacío significa "todas" (comportamiento por defecto para
  // cuentas nuevas, para no esconderles nada sin que lo hayan pedido).
  visibleCategories String[] @default([])
  createdAt    DateTime @default(now())
}

model Ping {
  id             String   @id @default(uuid())
  authorId       String
  message        String
  imageUrl       String?
  color          String?
  // Point geoespacial en SRID 4326 (WGS84, el estándar de lat/lng en GPS).
  // Prisma no modela geometry nativamente: se define aquí como Unsupported
  // y se lee/escribe con SQL crudo en el repositorio (ver prisma-ping.repository.ts).
  location       Unsupported("geography(Point, 4326)")
  radiusMeters   Int
  isSocial       Boolean  @default(false)
  categoryKey    String   @default("general")
  maxRecipients  Int
  deliveredCount Int      @default(0)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  // Borrado suave: si el usuario "elimina" su anuncio, no se borra la
  // fila (las conversaciones y denuncias podrían referenciarla) — solo
  // deja de aparecer en cualquier consulta normal.
  deletedAt      DateTime?

  threads PingThread[]

  @@index([status, expiresAt])
}

// Un hilo = la conversación entre el autor del ping y UNA persona que
// respondió. Cada respondiente tiene su propio hilo privado; no se ven
// entre ellos (cada quien le habla al dueño del ping, no le interesa
// ver lo que dijeron otros).
model PingThread {
  id          String   @id @default(uuid())
  pingId      String
  ping        Ping     @relation(fields: [pingId], references: [id])
  responderId String
  createdAt   DateTime @default(now())

  messages ThreadMessage[]

  @@unique([pingId, responderId])
  @@index([pingId])
}

model ThreadMessage {
  id        String     @id @default(uuid())
  threadId  String
  thread    PingThread @relation(fields: [threadId], references: [id])
  senderId  String
  message   String
  imageUrl  String?
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

// El radio de escucha es una preferencia del usuario ("qué tanto quiero
// que me fastidien"), no una propiedad del ping. Un ping te "alcanza" si
// tu círculo de escucha y el círculo de alcance del ping se tocan —
// ver PrismaUserLocatorRepository y PrismaPingRepository.findColliding.
model UserLastLocation {
  userId               String   @id
  pushToken            String
  location             Unsupported("geography(Point, 4326)")
  listeningRadiusMeters Int     @default(200)
  updatedAt            DateTime @updatedAt
}

// Una vista = alguien (no el autor) abrió el detalle de este ping. Única
// por (pingId, viewerId): entrar 10 veces cuenta como 1 sola vista.
model PingView {
  id        String   @id @default(uuid())
  pingId    String
  viewerId  String
  createdAt DateTime @default(now())

  @@unique([pingId, viewerId])
  @@index([pingId])
}

// El "tipo" de anuncio (venta, compra, ayuda, info...). Editable desde
// el panel de admin — "key" es el valor que se guarda en Ping.categoryKey
// y nunca debería cambiar una vez creado (renombra "label", no "key").
model PingCategory {
  key       String  @id
  label     String
  icon      String? // nombre de ícono de Ionicons, ej. "cart-outline"
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

// Una denuncia siempre es sobre UN USUARIO (comportamiento), y
// opcionalmente puede estar ligada a un anuncio puntual como contexto.
model Report {
  id             String    @id @default(uuid())
  reporterId     String
  reportedUserId String
  pingId         String?
  reason         String
  status         String    @default("pending") // pending | reviewed | dismissed
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  reviewedById   String?

  @@index([status])
  @@index([reportedUserId])
}

// Bloqueo dirigido: A bloqueó a B. Se consulta en ambos sentidos al
// armar el feed y al iniciar conversaciones (ver GetNearbyPingsUseCase y
// StartThreadUseCase) — que A no vea a B implica también que B no vea a A.
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
